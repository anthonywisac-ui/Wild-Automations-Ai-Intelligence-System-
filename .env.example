# Wild Automations - Environment Variables
# Copy to .env and fill in your values

# ============ Apify ============
APIFY_API_KEY=                  # Get from: https://console.apify.com/account/integrations

# ============ Database ============
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_TABLE=bot_alerts

# ============ AI / LLM ============
OPENAI_API_KEY=
AI_PROVIDER=openai
# For Ollama: AI_PROVIDER=ollama and set OLLAMA_BASE_URL

# ============ Delivery Channels ============
# WhatsApp via Whapi (https://whapi.cloud)
WHAPI_API_KEY=

# WhatsApp via Meta Cloud API
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=

# SMS via Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Recipient phone number for alerts (WhatsApp/SMS format: e.g., +971501234567)
NOTIFY_TO=

# ============ LinkedIn (vendored cookie-auth scraper) ============
# LinkedIn people-search is login-walled. Paste YOUR OWN li_at session cookie so
# the vendored scraper (plugins/linkedin_vendor.py) can authenticate. Get it via:
#   browser DevTools → Application → Cookies → https://www.linkedin.com → copy
#   the value of the `li_at` cookie. Leave blank to disable LinkedIn (falls back
#   to Google Maps + Instagram gracefully).
LINKEDIN_LI_AT=

# ============ Scraping ============
SCRAPE_CONCURRENCY=5
DOMAIN_CONCURRENCY=2
MAX_PIPELINE_RETRIES=3
RESPECT_ROBOTS=true

# ============ Worker Pipeline ============
WORKER_CONCURRENCY=5

# ============ Mode ============
# Set to true to validate config and crawl one portal without delivering
DRY_RUN=false

# ============ Logging ============
LOG_LEVEL=INFO
