{
  "_meta": {
    "purpose": "Platform-specific query templates for the Intent Query Generator. {q}=intent phrase, {service}=service, {role}=job role, {category}=business category, {location}=geo, {pain}=pain phrase, {tech}=technology, {signal}=growth signal. Data-driven — add platforms/tiers without code changes.",
    "version": "1.0.0"
  },
  "platforms": {
    "google": {
      "hot": [
        "looking for {q}",
        "need {q}",
        "recommend {q}"
      ],
      "warm": [
        "{q} not working",
        "struggling with {q}",
        "better {q}"
      ],
      "problem": [
        "{pain} solution",
        "fix {pain}"
      ],
      "hiring": [
        "hiring {role}"
      ],
      "comparison": [
        "best {q}",
        "alternative to {q}",
        "{q} vs"
      ]
    },
    "google_maps": {
      "hot": [
        "{category} in {location}"
      ],
      "problem": [
        "{category} {location} reviews"
      ],
      "comparison": [
        "{category} near {location}"
      ]
    },
    "linkedin": {
      "hiring": [
        "site:linkedin.com \"hiring\" {role}",
        "site:linkedin.com \"we're hiring\" {q}"
      ],
      "hot": [
