        "site:reddit.com \"{pain}\"",
        "site:reddit.com \"anyone else {pain}\""
      ],
      "comparison": [
        "site:reddit.com \"recommend {q}\"",
        "site:reddit.com \"{q} alternative\""
      ],
      "hot": [
        "site:reddit.com \"looking for {q}\""
